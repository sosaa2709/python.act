import tkinter as tk
from tkinter import ttk

ventana=tk.Tk()
ventana.title("Administracion de alumnos")
ventana.geometry("500x300")

notebook=ttk.Notebook(ventana)
notebook.pack(fill="both", expand=True)

pestaña1=ttk.Frame(notebook)
notebook.add(pestaña1, text="Alumnos")
etiqueta_nombre=ttk.Label(pestaña1, text="Ingrese el nombre").pack()
entrada_nombre=ttk.Entry(pestaña1)
entrada_nombre.pack()
etiqueta_apellido=ttk.Label(pestaña1, text="Ingrese el apellido").pack()
entrada_apellido=ttk.Entry(pestaña1)
entrada_apellido.pack()
etiqueta_año=tk.Label(pestaña1, text="Seleccione el año: ").pack()
años= ["1", "2", "3", "4", "5", "6"]
año_var = tk.StringVar()
combo_año = ttk.Combobox(pestaña1, textvariable=año_var, values=años, state="readonly")
combo_año.set("1")
combo_año.pack()

pestaña2=ttk.Frame(notebook)
notebook.add(pestaña2, text="Información")

ventana.mainloop()