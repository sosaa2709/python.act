import tkinter as tk
from tkinter import ttk

ventana = tk.Tk()
ventana.title("Agenda")
ventana.geometry("500x400")

notebook = ttk.Notebook(ventana)
notebook.pack(fill="both", expand=True)

# Pestaña Contactos
pestaña_contactos = ttk.Frame(notebook)
notebook.add(pestaña_contactos, text="Contactos")

# Pestaña Agregar
pestaña_agregar = ttk.Frame(notebook)
notebook.add(pestaña_agregar, text="Agregar")

# Campos
tk.Label(pestaña_agregar, text="Nombre:").pack()
entrada_nombre = tk.Entry(pestaña_agregar)
entrada_nombre.pack()

tk.Label(pestaña_agregar, text="Apellido:").pack()
entrada_apellido = tk.Entry(pestaña_agregar)
entrada_apellido.pack()

def mostrar():
    nombre = entrada_nombre.get()
    apellido = entrada_apellido.get()
    texto = f"{nombre} {apellido}"
    etiqueta_resultado.config(text=texto)

etiqueta_resultado = tk.Label(pestaña_contactos, text="Resultado aparecerá aquí")
etiqueta_resultado.pack(pady=20)

boton = tk.Button(pestaña_agregar, text="Mostrar", command=mostrar)
boton.pack(pady=10)

ventana.mainloop()